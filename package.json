{
  "name": "twexplain",
  "displayName": "twexplain",
  "description": "Explains Tailwind class strings in a side panel",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:twexplain.panel",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "twexplain": [
        {
          "type": "webview",
          "id": "twexplain.panel",
          "name": "Classes"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "twexplain",
          "title": "Tailwind Inspector",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ds": "vitest run --config vitest.integration.config.ts",
    "test:golden": "vitest run --config vitest.integration.config.ts src/explain/golden.integration.test.ts",
    "compile-integration": "node esbuild.integration.js",
    "link-fixture-modules": "ln -sfn ../../../../node_modules src/integration/__fixtures__/workspace/node_modules",
    "pretest:integration": "npm run link-fixture-modules && npm run compile-integration && npm run build",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
